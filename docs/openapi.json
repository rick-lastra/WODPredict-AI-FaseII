{
    "openapi": "3.1.0",
    "info": {
        "title": "WODPredict-AI API",
        "description": "Predice si un atleta de CrossFit tendrá sobrecarga al día siguiente (UnderCover Fitness).",
        "version": "1.0.0"
    },
    "paths": {
        "/": {
            "get": {
                "summary": "Health Check",
                "description": "Health check: confirma que la API y el modelo están cargados.",
                "operationId": "health_check__get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/modelo": {
            "get": {
                "summary": "Info Modelo",
                "description": "Ficha técnica del modelo: umbral, métricas en prueba, dataset y versiones.",
                "operationId": "info_modelo_modelo_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/predict": {
            "post": {
                "summary": "Predecir",
                "description": "Recibe los datos de UN atleta y devuelve su riesgo de sobrecarga al día siguiente.",
                "operationId": "predecir_predict_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DatosAtleta"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Prediccion"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "DatosAtleta": {
                "properties": {
                    "level": {
                        "type": "string",
                        "enum": [
                            "novato",
                            "intermedio",
                            "élite"
                        ],
                        "title": "Level",
                        "description": "Nivel del atleta"
                    },
                    "sex": {
                        "type": "string",
                        "enum": [
                            "F",
                            "M"
                        ],
                        "title": "Sex",
                        "description": "Sexo"
                    },
                    "language": {
                        "type": "string",
                        "enum": [
                            "es",
                            "en"
                        ],
                        "title": "Language",
                        "description": "Idioma de sus comentarios"
                    },
                    "age": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 80.0,
                                "minimum": 16.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Age",
                        "description": "Edad en años"
                    },
                    "days_since_first_session": {
                        "type": "integer",
                        "maximum": 3650.0,
                        "minimum": 0.0,
                        "title": "Days Since First Session",
                        "description": "Días desde su primera sesión"
                    },
                    "days_since_prev_session": {
                        "type": "integer",
                        "maximum": 365.0,
                        "minimum": 1.0,
                        "title": "Days Since Prev Session",
                        "description": "Días desde la sesión anterior"
                    },
                    "sessions_last_3d": {
                        "type": "integer",
                        "maximum": 3.0,
                        "minimum": 0.0,
                        "title": "Sessions Last 3D",
                        "description": "Sesiones en los últimos 3 días"
                    },
                    "sessions_last_7d": {
                        "type": "integer",
                        "maximum": 7.0,
                        "minimum": 0.0,
                        "title": "Sessions Last 7D",
                        "description": "Sesiones en los últimos 7 días"
                    },
                    "sessions_last_28d": {
                        "type": "integer",
                        "maximum": 28.0,
                        "minimum": 0.0,
                        "title": "Sessions Last 28D",
                        "description": "Sesiones en los últimos 28 días"
                    },
                    "load_last_3d": {
                        "type": "number",
                        "maximum": 10000.0,
                        "minimum": 0.0,
                        "title": "Load Last 3D",
                        "description": "Carga de los últimos 3 días"
                    },
                    "load_last_7d": {
                        "type": "number",
                        "maximum": 20000.0,
                        "minimum": 0.0,
                        "title": "Load Last 7D",
                        "description": "Carga de los últimos 7 días"
                    },
                    "mean_session_load_28d": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 5000.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Mean Session Load 28D",
                        "description": "Carga promedio por sesión en 28 días"
                    },
                    "acwr3_freq": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 4.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Acwr3 Freq",
                        "description": "ACWR de frecuencia (3 días)"
                    },
                    "acwr3_load": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 4.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Acwr3 Load",
                        "description": "ACWR de carga (3 días)"
                    },
                    "acwr_freq": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 4.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Acwr Freq",
                        "description": "ACWR de frecuencia (7 días)"
                    },
                    "acwr_load": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 4.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Acwr Load",
                        "description": "ACWR de carga (7 días)"
                    },
                    "prev_rpe": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 10.0,
                                "minimum": 1.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Prev Rpe",
                        "description": "RPE de la sesión anterior (1 a 10)"
                    },
                    "prev_session_load": {
                        "type": "number",
                        "maximum": 5000.0,
                        "minimum": 0.0,
                        "title": "Prev Session Load",
                        "description": "Carga de la sesión anterior"
                    },
                    "prev_has_note": {
                        "type": "integer",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Prev Has Note",
                        "description": "1 si dejó comentario en la sesión anterior"
                    },
                    "prob_fatiga_prev_session": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 1.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Prob Fatiga Prev Session",
                        "description": "Prob. de fatiga del comentario anterior"
                    },
                    "prob_fatiga_last_note": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 1.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Prob Fatiga Last Note",
                        "description": "Prob. de fatiga del último comentario"
                    },
                    "days_since_last_note": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 3650.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Days Since Last Note",
                        "description": "Días desde el último comentario"
                    },
                    "notes_last_28d": {
                        "type": "integer",
                        "maximum": 60.0,
                        "minimum": 0.0,
                        "title": "Notes Last 28D",
                        "description": "Comentarios en los últimos 28 días"
                    }
                },
                "type": "object",
                "required": [
                    "level",
                    "sex",
                    "language",
                    "days_since_first_session",
                    "days_since_prev_session",
                    "sessions_last_3d",
                    "sessions_last_7d",
                    "sessions_last_28d",
                    "load_last_3d",
                    "load_last_7d",
                    "prev_session_load",
                    "prev_has_note",
                    "notes_last_28d"
                ],
                "title": "DatosAtleta",
                "example": {
                    "acwr3_freq": 1.2,
                    "acwr3_load": 1.3,
                    "acwr_freq": 1.1,
                    "acwr_load": 1.25,
                    "age": 31,
                    "days_since_first_session": 365,
                    "days_since_last_note": 1,
                    "days_since_prev_session": 1,
                    "language": "es",
                    "level": "élite",
                    "load_last_3d": 760,
                    "load_last_7d": 1650,
                    "mean_session_load_28d": 310,
                    "notes_last_28d": 8,
                    "prev_has_note": 1,
                    "prev_rpe": 8,
                    "prev_session_load": 420,
                    "prob_fatiga_last_note": 0.7,
                    "prob_fatiga_prev_session": 0.7,
                    "sessions_last_28d": 18,
                    "sessions_last_3d": 2,
                    "sessions_last_7d": 5,
                    "sex": "F"
                }
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "Prediccion": {
                "properties": {
                    "probabilidad": {
                        "type": "number",
                        "title": "Probabilidad"
                    },
                    "umbral": {
                        "type": "number",
                        "title": "Umbral"
                    },
                    "prediccion": {
                        "type": "integer",
                        "title": "Prediccion"
                    },
                    "riesgo": {
                        "type": "string",
                        "title": "Riesgo"
                    },
                    "recomendacion": {
                        "type": "string",
                        "title": "Recomendacion"
                    },
                    "version_modelo": {
                        "type": "string",
                        "title": "Version Modelo"
                    }
                },
                "type": "object",
                "required": [
                    "probabilidad",
                    "umbral",
                    "prediccion",
                    "riesgo",
                    "recomendacion",
                    "version_modelo"
                ],
                "title": "Prediccion"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
